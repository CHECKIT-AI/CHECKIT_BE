# Passwords and connection strings belong only in the local .env or process environment.
# Copy a PostgreSQL URI from Supabase Connect; use checkit_backend as the DB role.
# Pooler usernames may require checkit_backend.<project-ref>.
CHECKIT_DATABASE_URL=
# Provisioning only. Never pass this owner connection to the web application.
CHECKIT_ADMIN_DATABASE_URL=
CHECKIT_BACKEND_PASSWORD=

# Development defaults use HTTP on this machine only.
CHECKIT_ENVIRONMENT=development
CHECKIT_COOKIE_SECURE=false
CHECKIT_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
# Optional in development (generated in memory when empty). Production: >=32 random characters.
CHECKIT_CSRF_SECRET=
CHECKIT_SESSION_SECONDS=604800

# Email signup is enabled only after SMTP and the frontend verification page are configured.
# Uses STARTTLS, typically port 587. No email token is printed or returned by signup.
CHECKIT_SMTP_HOST=
CHECKIT_SMTP_PORT=587
CHECKIT_SMTP_USERNAME=
CHECKIT_SMTP_PASSWORD=
CHECKIT_SMTP_FROM=
CHECKIT_VERIFICATION_PAGE_URL=
